# Home Manager module. It installs the molva CLI, runs its daemon as a user service, and
# writes the Hyprland hotkey file from MolvAI's own settings. It does not edit
# hyprland.lua: the one include line is offered by the GUI help and in the documentation.
#
# The settings and the weights are rendered into the Nix store. A switch is the only thing
# that changes them. The GUI keeps its settings page visible but disabled while the config is
# a store symlink, and `molva config set` still refuses to write it.
{ self }:
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.programs.molvai;
  hyprland = config.wayland.windowManager.hyprland;
  # `configType` arrived with Hyprland's Lua config; an older Home Manager has no such option,
  # and its hyprlang config would break on a Lua line
  hyprlandLua = (hyprland.enable or false) && (hyprland.configType or "hyprlang") == "lua";

  # The GUI is a separate binary: the module can install one when given a package, but it does
  # not assume that a CLI-only NixOS host has one. The command keeps an AppImage or a desktop
  # package usable without adding a second package source
  guiCommand =
    if cfg.guiAutostart.command != null then
      cfg.guiAutostart.command
    else if cfg.guiPackage != null then
      lib.getExe cfg.guiPackage
    else
      "molva-gui";

  # The catalog is the same file the CLI reads: one list of weights, two consumers
  catalog = builtins.fromTOML (builtins.readFile (self + "/models.toml"));
  models = builtins.listToAttrs (
    map (model: {
      name = model.name;
      value = model;
    }) catalog.model
  );
  selected = map (
    name: models.${name} or (throw "programs.molvai.models: no model called ${name} in models.toml")
  ) cfg.models;

  fetched = map (model: {
    inherit model;
    file = pkgs.fetchurl {
      url = model.url;
      hash = builtins.convertHash {
        hash = "sha256:${model.sha256}";
        toHashFormat = "sri";
      };
    };
  }) selected;

  # A directory, not one path: `stt.model_path` is the model directory, and the catalog
  # decides the file name inside it. So a second model costs one symlink, and the CLI keeps
  # its usual `molva models list`.
  weights =
    if cfg.modelsDirectory != null then
      cfg.modelsDirectory
    else
      pkgs.runCommand "molvai-models" { } ''
        mkdir -p $out
        ${lib.concatMapStringsSep "\n" (entry: "ln -s ${entry.file} $out/${entry.model.file_name}") fetched}
      '';

  model = models.${cfg.model};
  usesTranscribe = model.engine == "transcribe-cpp";
  engine = model.engine;
  cli =
    if usesTranscribe && cfg.transcribeCli != null then
      "${lib.getBin cfg.transcribeCli}/bin/transcribe-cli"
    else
      "";

  generated = {
    version = 2;
    ui_language = cfg.uiLanguage;
    stt = {
      inherit engine;
      model = cfg.model;
      model_path = "${weights}";
      language = cfg.language;
      streaming_inject = false;
      transcribe_cli = cli;
      transcribe_backend = cfg.transcribeBackend;
    };
  };
  # The notice comes from its own option, not from the free-form settings override. The
  # settings page itself is always visible and disabled while the config is a store path
  settings = lib.recursiveUpdate (lib.recursiveUpdate generated cfg.settings) {
    gui.show_managed_notice = cfg.showNotice;
  };
  configFile = (pkgs.formats.toml { }).generate "molvai-config.toml" settings;

  # The binds file is generated by the same code that the GUI uses. The file goes into the
  # store, so a managed home never runs a command at activation to write the user's config
  hyprlandBinds =
    pkgs.runCommand "molvai-hyprland.lua"
      {
        nativeBuildInputs = [ cfg.package ];
      }
      ''
        export HOME=$TMPDIR/home
        export XDG_CONFIG_HOME=$TMPDIR/config
        mkdir -p "$HOME" "$XDG_CONFIG_HOME/hypr"
        ${lib.getExe cfg.package} --config ${configFile} setup hyprland --write >/dev/null
        cp "$XDG_CONFIG_HOME/hypr/molvai.lua" $out
      '';
in
{
  options.programs.molvai = {
    enable = lib.mkEnableOption "MolvAI, system-wide voice input";

    package = lib.mkOption {
      type = lib.types.package;
      default = self.packages.${pkgs.stdenv.hostPlatform.system}.molva;
      defaultText = lib.literalExpression "the molva package of this flake";
      description = "The package that provides the molva command";
    };

    daemon.enable = lib.mkOption {
      type = lib.types.bool;
      default = pkgs.stdenv.hostPlatform.isLinux;
      defaultText = lib.literalExpression "pkgs.stdenv.hostPlatform.isLinux";
      description = ''
        Run `molva daemon` as a user service of the graphical session. The hotkeys only call
        `molva record`, which asks the daemon, so without it they report that the daemon is
        not running. The MolvAI GUI sees a running daemon and does not start a second one
      '';
    };

    hyprland.enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Bind the hotkeys from MolvAI's settings in Hyprland: each switch writes
        {file}`$XDG_CONFIG_HOME/hypr/molvai.lua` and hyprland.lua includes it. It takes effect
        only with `wayland.windowManager.hyprland.configType = "lua"`
      '';
    };

    uiLanguage = lib.mkOption {
      type = lib.types.str;
      default = "auto";
      description = "Interface language: `auto`, `ru` or `en`; `auto` follows the system";
    };

    language = lib.mkOption {
      type = lib.types.str;
      default = "ru";
      description = "Language of the speech, an ISO-639-1 code or `auto`";
    };

    model = lib.mkOption {
      type = lib.types.str;
      default = "gigaam-v3-e2e-rnnt-q4_k_m";
      description = ''
        Recognition model from {file}`models.toml`. The default is the GigaAM-v3 name that
        the station's agent uses, at the same Q4_K_M quantization
      '';
    };

    models = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ cfg.model ];
      description = ''
        Models to fetch into the store. `model` must be one of them. A name comes from
        {file}`models.toml`, and an unknown name fails the switch
      '';
    };

    modelsDirectory = lib.mkOption {
      type = lib.types.nullOr lib.types.path;
      default = null;
      description = ''
        A directory that already holds the weights, for a machine that gets them another
        way. When set, `models` is not fetched and the directory replaces it
      '';
    };

    transcribeCli = lib.mkOption {
      type = lib.types.nullOr lib.types.package;
      default = self.packages.${pkgs.stdenv.hostPlatform.system}.transcribe-cpp;
      defaultText = lib.literalExpression "the transcribe-cpp package of this flake";
      description = ''
        The `transcribe-cli` binary that runs GigaAM weights. `null` is allowed only when
        the selected model runs on whisper.cpp
      '';
    };

    transcribeBackend = lib.mkOption {
      type = lib.types.str;
      default = "auto";
      description = "Compute backend for transcribe.cpp: `auto`, `cpu`, `vulkan`, `cuda`…";
    };

    showNotice = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Show the banner that says the settings come from Nix. It is off by default, so a
        managed home opens without it
      '';
    };

    guiPackage = lib.mkOption {
      type = lib.types.nullOr lib.types.package;
      default = null;
      description = ''
        The MolvAI GUI package to install. When null, the module does not install a GUI and
        `guiAutostart.command` must name one that is already on `PATH`, such as an AppImage
      '';
    };

    guiAutostart = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = cfg.daemon.enable;
        defaultText = lib.literalExpression "programs.molvai.daemon.enable";
        description = ''
          Start the GUI at login together with the daemon. The GUI owns the tray icon; the
          daemon alone does not create one
        '';
      };

      command = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        description = ''
          The command an autostart entry runs. When null, the module uses the installed
          {option}`guiPackage`, or `molva-gui` from `PATH` when no package is given
        '';
      };
    };

    settings = lib.mkOption {
      type = lib.types.attrs;
      default = { };
      description = ''
        Settings merged over the generated ones. The shape is the TOML of
        {file}`molva config export`: for example
        `settings.stt.chunk_pause_ms = 400`
      '';
    };
  };

  config = lib.mkIf cfg.enable (
    lib.mkMerge [
      {
        assertions = [
          {
            assertion = builtins.elem cfg.model cfg.models;
            message = "programs.molvai.model must be one of programs.molvai.models";
          }
          {
            assertion = !usesTranscribe || cfg.transcribeCli != null;
            message = "programs.molvai.transcribeCli is null, but ${cfg.model} runs on transcribe.cpp";
          }
        ];

        home.packages = [ cfg.package ] ++ lib.optional (cfg.guiPackage != null) cfg.guiPackage;

        xdg.configFile."molva/config.toml" = {
          source = configFile;
          force = true;
        };
      }

      (lib.mkIf cfg.daemon.enable {
        systemd.user.services.molva-daemon = {
          Unit = {
            Description = "MolvAI daemon: the microphone, speech recognition and the paste";
            # The paste needs the compositor, so the daemon lives and dies with the session
            PartOf = [ "graphical-session.target" ];
            After = [ "graphical-session.target" ];
          };
          Service = {
            ExecStart = "${lib.getExe cfg.package} daemon";
            Restart = "on-failure";
            RestartSec = 5;
          };
          Install.WantedBy = [ "graphical-session.target" ];
        };
      })

      (lib.mkIf cfg.guiAutostart.enable {
        xdg.configFile."autostart/molvai-gui.desktop".text = ''
          [Desktop Entry]
          Type=Application
          Name=MolvAI
          Comment=System-wide voice input
          Exec=${guiCommand}
          Terminal=false
          X-GNOME-Autostart-enabled=true
        '';
      })

      (lib.mkIf (cfg.hyprland.enable && hyprlandLua) {
        xdg.configFile."hypr/molvai.lua" = {
          source = hyprlandBinds;
          force = true;
        };
        # The generated binds are a separate file only when hyprland.lua includes it. The
        # option promises the include, so the module adds the one line; pcall keeps a home
        # without the generated file working
        wayland.windowManager.hyprland.extraConfig = lib.mkAfter ''
          pcall(dofile, os.getenv("HOME") .. "/.config/hypr/molvai.lua")
        '';
      })
    ]
  );
}
