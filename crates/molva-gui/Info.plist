<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: MIT -->
<!-- Merged into the Info.plist that the Tauri bundler builds. Without a microphone string,
     macOS refuses recording with no dialog. A request from the sidecar daemon counts
     for the application -->
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>MolvAI records your voice while you dictate and turns it into text on this computer.</string>
</dict>
</plist>
