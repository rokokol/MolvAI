# All text files are stored and checked out with LF: the t.sh harness reads markers/*.txt
# line by line, and CRLF on Windows turned an empty line into a "\r" marker that matched
# every log line (the gate failed on a healthy run)
* text=auto eol=lf

# Do not touch binary fixtures and icons
*.wav binary
*.mp3 binary
*.ogg binary
*.flac binary
*.m4a binary
*.png binary
*.ico binary
*.icns binary
